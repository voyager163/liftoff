{
  "name": "@msn-control/liftoff",
  "version": "0.12.3",
  "description": "Interactive CLI for governed GenAI applications and APIs.",
  "type": "module",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/voyager163/liftoff#readme",
  "bugs": {
    "url": "https://github.com/voyager163/liftoff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voyager163/liftoff.git"
  },
  "keywords": [
    "genai",
    "api",
    "cli",
    "scaffold",
    "fastapi",
    "fastify",
    "golang",
    "pydanticai",
    "opentofu",
    "openspec",
    "mission-control"
  ],
  "bin": {
    "liftoff": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets/governance/modern/source-contracts.json",
    "assets/governance/single-maintainer-gitflow/activation-v2-graph.json",
    "assets/governance/single-maintainer-gitflow/activation-v3-graph.json",
    "assets/governance/single-maintainer-gitflow/assessment-controls.json",
    "assets/governance/single-maintainer-gitflow/policy-v7.md",
    "assets/governance/single-maintainer-gitflow/policy.md",
    "assets/governance/team-gitflow/assessment-controls.json",
    "assets/governance/team-gitflow/policy-v1.md",
    "assets/repair/windows-job-controller.ps1",
    "assets/skills/governance-assessment.md",
    "assets/skills/assessment.md",
    "assets/skills/repair.md",
    "assets/skills/setup.md",
    "assets/supported-stack.json",
    "assets/plugins/azure/opentofu-azure/.terraform.lock.hcl",
    "assets/plugins/azure/opentofu-azure/versions.tf",
    "assets/plugins/go-huma/go-backend/go.mod",
    "assets/plugins/go-huma/go-backend/go.sum",
    "assets/plugins/node-fastify/node-backend/package-lock.json",
    "assets/plugins/node-fastify/node-backend/package.json",
    "assets/plugins/python-fastapi/python-genai/function-requirements.txt",
    "assets/plugins/python-fastapi/python-genai/pyproject.toml",
    "assets/plugins/python-fastapi/python-genai/uv.lock",
    "assets/plugins/python-fastapi/python-standard/pyproject.toml",
    "assets/plugins/python-fastapi/python-standard/uv.lock",
    "assets/templates/common/frontend/package-lock.json",
    "assets/templates/common/frontend/package.json",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "GOVERNANCE.md",
    "SUPPORT.md",
    "DEVELOPER.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json",
    "build:native": "node scripts/native-bundle.mjs",
    "test": "vitest run",
    "coverage:cli": "node scripts/coverage-gate.mjs run cli",
    "coverage:gateway": "node scripts/coverage-gate.mjs run gateway",
    "audit:template-dependencies": "node scripts/audit-template-dependencies.mjs",
    "refresh:supported-stack": "node scripts/refresh-supported-stack-baseline.mjs --write",
    "check:supported-stack": "node scripts/refresh-supported-stack-baseline.mjs",
    "check:supported-stack-freshness": "node scripts/check-supported-stack-freshness.mjs",
    "canonicalize:python-locks": "node scripts/canonicalize-uv-lock.mjs assets/plugins/python-fastapi/python-standard/uv.lock assets/plugins/python-fastapi/python-genai/uv.lock",
    "smoke:package": "npm run build && node scripts/package-smoke-test.mjs",
    "verify:standard-node-templates": "npm run build && node scripts/verify-standard-node-templates.mjs",
    "verify:generated-containers": "npm run build && node scripts/verify-generated-containers.mjs",
    "verify:release-identity": "npm run build && node scripts/verify-release-identity.mjs",
    "prepare:release": "node scripts/release-artifact.mjs pack",
    "check:repository": "node scripts/check-repository-policy.mjs",
    "verify:published": "npm run build && node scripts/verify-published-package.mjs",
    "check": "npm run check:supported-stack && npm run build && npm test"
  },
  "engines": {
    "node": ">=24.20"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.6.0",
    "@vitest/coverage-v8": "5.0.0",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@cdktf/hcl2json": "0.21.0",
    "@inquirer/prompts": "^8.6.0",
    "cross-spawn": "^7.0.6",
    "picocolors": "^1.1.1",
    "smol-toml": "1.8.0",
    "yaml": "^2.9.0"
  }
}
