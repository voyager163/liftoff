┌─ Usage ──────────────────────────────────────────────────────────────────────────────────────┐
│ liftoff regions [search <query>]                                                             │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
┌─ Arguments ──────────────────────────────────────────────────────────────────────────────────┐
│ Argument  Description                                                                        │
│ ────────  ────────────────────────────────────────────────                                   │
│ query     Region name, slug, geography, or alias to search                                   │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
┌─ Subcommands ────────────────────────────────────────────────────────────────────────────────┐
│ • search                                                                                     │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
┌─ Project options ────────────────────────────────────────────────────────────────────────────┐
│ Option              Description                                                              │
│ ──────────────────  ───────────────────────────────                                          │
│ --cloud <provider>  Cloud provider (default: azure)                                          │
│ --region <region>   Exact region identifier                                                  │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
┌─ General options ────────────────────────────────────────────────────────────────────────────┐
│ Option  Description                                                                          │
│ ──────  ──────────────────────────                                                           │
│ --help  Show command-specific help                                                           │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
"
`;

exports[`complete help screens > snapshots rich update command help 1`] = `
"┌─ LIFTOFF / UPDATE ───────────────────────────────────────────────────────────────────────────┐
