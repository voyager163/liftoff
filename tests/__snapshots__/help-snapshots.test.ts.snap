exports[`complete help screens > snapshots compact adopt command help 1`] = `
"LIFTOFF / ADOPT
Review in-place adoption of a supported existing application without replacing
its business code

Usage
─────
liftoff adopt <project-path>

Arguments
─────────
Argument      Description
────────────  ──────────────────────────────────────────────────────────────────
project-path  Existing supported application; never a fresh scaffold destination

Project options
───────────────
Option              Description
──────────────────  ────────────────────────────────────────────────────────────
--project <path>    Explicit existing project or component boundary
--profile <id>      Installed supported standards profile target; never a
                    framework conversion
--component <path>  Confined existing component path within the project
--proposal <file>   Exact reviewed application mappings and additions from
                    external staging

Command options
───────────────
Option     Description
─────────  ─────────────────────────────────────────────────────────────────────
--check    Preview without project writes, preparation, scripts, or network
           effects
--recover  Recover only attributable recorded adoption effects; never start a
           new plan

Consent options
───────────────
Option                          Description
──────────────────────────────  ────────────────────────────────────────────────
--approve-plan <fingerprint>    Approve only the exact saved file/metadata plan
                                after its required verification
--verify-plan <fingerprint>     Authorize only the exact saved private
                                verification scope, not file commit
--allow-dependency-preparation  Separately permit declared locked preparation
                                with --verify-plan
--allow-network                 Separately permit declared
                                verification/preparation network effects with
                                --verify-plan

Output options
──────────────
Option  Description
──────  ───────────────────────────────────────────────────────────────────────
--json  Emit one schema-1 adoption result without prompting or implicit consent

General options
───────────────
Option  Description
──────  ──────────────────────────
--help  Show command-specific help

"
`;

