exports[`complete help screens > snapshots rich governance command help 1`] = `
"┌─ LIFTOFF / GOVERNANCE ───────────────────────────────────────────────────────────────────────┐
│ Historical projects retain schema-2 planning and execution. V8 projects retain schema-3      │
│ status, resume and verify inspection; recorded phases are not current proof. An exact        │
│ --revalidation-publication selects existing successor proof, never approval or execution.    │
│ Verify exits 0 for complete or inapplicable selected scope, 2 for consistent incomplete      │
│ work, and 1 for inspection failure. For separate schema-7 v8 verification, select --scope    │
│ local --local-operation verify: plan --inputs <request.json>, approve --plan <fingerprint>   │
│ --inputs <consent.json>, then apply-next --plan <fingerprint> --execute. Planning probes     │
│ installed tools and saves an external preview; approval separately saves consent. Without    │
│ --execute, apply-next only inspects saved progress. Keep public request and consent files    │
│ outside the project. Native Manual uses verify-manual-native and approve-manual-native with  │
│ independent infrastructure preparation/network consent and the advertised qualified          │
│ host/tool limits. Locked provider downloads and local validation grant no Azure/GitHub       │
│ resource operations. Initialized OpenSpec requires explicit generated-baseline scope         │
│ attestation; it is not domain verification; the private workspace is not a sandbox. Separate │
│ schema-5 completion uses --local-operation finalize for admitted Manual/Spec Kit             │
│ verification, then --local-operation publish for exact target review, independent approval   │
│ and execution. Both require their own closed --inputs for plan/approve and exact --plan for  │
│ apply-next. For publication, governance recover --plan <fingerprint> --execute recovers only │
│ that attributed transaction; without --execute it only inspects saved progress. Failure does │
│ not imply rollback. Separate schema-6 --local-operation revalidate-successor constructs or   │
│ reviews exact records from completed verification of an existing supported successor; it     │
│ requires independent publication approval and explicit execution/recovery. Committed         │
│ incomplete revalidation stays active and exits 2. No successor creation, OpenSpec            │
│ finalization, provider or whole-directory rollback authority is granted. Local operations    │
│ otherwise exit 0 for a completed requested operation or nonexecuting inspection, and 1 for   │
│ refusal, failure, or uncertainty.                                                            │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
┌─ Usage ──────────────────────────────────────────────────────────────────────────────────────┐
│ liftoff governance                                                                           │
│ <status|plan|approve|apply-next|credential-enroll|recover|resume|verify|assess>              │
│ [project-path]                                                                               │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
┌─ Arguments ──────────────────────────────────────────────────────────────────────────────────┐
│ Argument      Description                                                                    │
│ ────────────  ──────────────────────────                                                     │
│ project-path  Liftoff project to inspect                                                     │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
┌─ Subcommands ────────────────────────────────────────────────────────────────────────────────┐
│ • status                                                                                     │
│ • plan                                                                                       │
│ • approve                                                                                    │
│ • apply-next                                                                                 │
│ • credential-enroll                                                                          │
│ • recover                                                                                    │
│ • resume                                                                                     │
│ • verify                                                                                     │
│ • assess                                                                                     │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
┌─ Project options ────────────────────────────────────────────────────────────────────────────┐
│ Option            Description                                                                │
│ ────────────────  ────────────────────────────────────────────────────────────────────────── │
│ --project <path>  Liftoff project path                                                       │
│ --inputs <file>   Public activation configuration or explicit local request/consent JSON;    │
│                   never credentials or state                                                 │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
┌─ Command options ────────────────────────────────────────────────────────────────────────────┐
│ Option                                    Description                                        │
│ ────────────────────────────────────────  ────────────────────────────────────────────────── │
│ --scope <scope>                           Execution/verification boundary: local,            │
│                                           activation, or lifecycle (default: activation)     │
│ --local-operation <operation>             v8 only: verify, finalize, publish, or             │
│                                           revalidate-successor with --scope local;           │
│                                           publication operations also support recover        │
│ --revalidation-publication <fingerprint>  Inspect one exact v8 successor publication; not    │
│                                           approval or execution                              │
│ --recover-phase <phase>                   Plan explicit recovery of one failed or            │
│                                           interrupted phase without executing it             │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
┌─ Consent options ────────────────────────────────────────────────────────────────────────────┐
│ Option                Description                                                            │
│ ────────────────────  ────────────────────────────────────────────────────────────────────── │
│ --plan <fingerprint>  Exact project-bound fingerprint from governance plan                   │
│ --protected-stdin     Credential enrollment is currently unavailable; this flag reads no     │
│                       secret                                                                 │
│ --execute             Execute the reviewed apply-next/recover operation; planning and        │
│                       approval save external metadata separately                             │
│ --live                Assess only: request bounded read-only GitHub/Azure metadata with      │
│                       existing permissions                                                   │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
┌─ Output options ─────────────────────────────────────────────────────────────────────────────┐
│ Option  Description                                                                          │
│ ──────  ──────────────────────────                                                           │
│ --json  Emit machine-readable JSON                                                           │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
┌─ General options ────────────────────────────────────────────────────────────────────────────┐
│ Option  Description                                                                          │
│ ──────  ──────────────────────────                                                           │
│ --help  Show command-specific help                                                           │
└──────────────────────────────────────────────────────────────────────────────────────────────┘
"
`;

