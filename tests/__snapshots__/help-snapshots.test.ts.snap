exports[`complete help screens > snapshots compact update command help 1`] = `
"LIFTOFF / UPDATE
Reconcile Liftoff-managed core files in a project

Usage
─────
liftoff update [project-path]

Arguments
─────────
Argument      Description
────────────  ──────────────────────────────
project-path  Generated project to reconcile

Project options
───────────────
Option            Description
────────────────  ────────────
--project <path>  Project path

Command options
───────────────
Option   Description
───────  ───────────────────────────────────────────
--check  Report drift without changing project files

Consent options
───────────────
Option   Description
───────  ──────────────────────────────
--force  Replace modified managed files

Output options
──────────────
Option  Description
──────  ──────────────────────────
--json  Emit machine-readable JSON

General options
───────────────
Option  Description
──────  ──────────────────────────
--help  Show command-specific help

"
`;

exports[`complete help screens > snapshots compact upgrade command help 1`] = `
