exports[`complete help screens > snapshots compact general help 1`] = `
"╻  ╻┏━╸╺┳╸┏━┓┏━╸┏━╸
┃  ┃┣╸  ┃ ┃ ┃┣╸ ┣╸
┗━╸╹╹   ╹ ┗━┛╹  ╹
Mission Control Liftoff 0.10.1 - Initialize a governed application and prepare
its local workstation.
Usage
─────
liftoff <command> [options]

Global options
──────────────
Option     Description
─────────  ──────────────────────────────────
--version  Show the installed Liftoff version
--help     Show general help

Onboarding
──────────
Command  Description
───────  ────────────────────────────────────────────────
init     Initialize a project and prepare its workstation
plan     Preview generated artifacts
migrate  Adopt an existing project

Maintenance
───────────
Command   Description
────────  ──────────────────────────────────────────────────────────────────────
validate  Validate a generated project manifest
update    Reconcile Liftoff-managed core files in a project
upgrade   Replace the supported global npm Liftoff CLI; project templates use
          update separately
doctor    Check local and project readiness

Reference
─────────
Command    Description
─────────  ─────────────────────────────────────
help       Show general or command-specific help
patterns   List GenAI patterns
providers  List cloud providers
regions    List or search provider regions

Operations
──────────
Command     Description
──────────  ───────────────────────────────────────────
governance  Inspect deterministic governance activation
dev         Print Docker Compose helper commands
infra       Print OpenTofu helper commands

i Tip: Run \`liftoff help <command>\` for command-specific usage.
"
`;

exports[`complete help screens > snapshots compact governance command help 1`] = `
"LIFTOFF / GOVERNANCE
Inspect deterministic governance activation

Usage
─────
liftoff governance <status|plan|apply-next|resume|verify> [project-path]

Arguments
─────────
Argument      Description
────────────  ──────────────────────────
project-path  Liftoff project to inspect

Subcommands
───────────
- status
- plan
- apply-next
- resume
- verify

Project options
───────────────
Option            Description
────────────────  ────────────────────
--project <path>  Liftoff project path

Consent options
───────────────
Option     Description
─────────  ─────────────────────────────────────────────────────────────────────
--execute  Execute the reviewed governance apply-next plan; required for any
           mutation

Output options
──────────────
Option  Description
──────  ──────────────────────────
--json  Emit machine-readable JSON

General options
───────────────
Option  Description
──────  ──────────────────────────
--help  Show command-specific help

"
`;

exports[`complete help screens > snapshots compact init command help 1`] = `
"LIFTOFF / INIT
Initialize a project and prepare its workstation

Usage
─────
liftoff init [project-name]

Arguments
─────────
Argument      Description
────────────  ────────────────────────────────────────
project-name  Project identity or child directory name

Project options
───────────────
Option                      Description
──────────────────────────  ────────────────────────────────────────────────────
--project <path>            Project name or project path
--type <workload>           Project workload type
--genai / --no-genai        Create a GenAI project; use --no-genai for a
                            standard API
--api <stack>               Backend API stack
--pattern <pattern>         GenAI application pattern
--cloud <provider>          Cloud provider (default: azure)
--region <region>           Cloud deployment region (default: eastus)
--frontend / --no-frontend  Include the Vue frontend starter (default: false)
--environments <list>       Comma-separated environments (default:
                            dev,staging,prod)
--config <file>             Load deterministic project options from JSON

Framework options
─────────────────
Option                                   Description
───────────────────────────────────────  ───────────────────────────────────────
--spec <framework>                       Spec-driven framework (default:
                                         openspec)
--agents <list>                          Comma-separated AI coding agents
                                         (default: copilot)
--default-agent <agent>                  Primary agent for Spec Kit when
                                         multiple agents are selected
--governance <profile>                   Repository-governance profile (default:
                                         single-maintainer-gitflow)
--code-apps-plugin /                     Request the Microsoft Code Apps agent
--no-code-apps-plugin                    plugin (Preview) (default: false)
--copilot-cloud / --no-copilot-cloud     Set up the GitHub-hosted Copilot coding
                                         agent for OpenSpec (default: false)

Consent options
───────────────
Option                        Description
────────────────────────────  ──────────────────────────────────────────────────
--configure-openspec-profile  Authorize the required global OpenSpec workflow
                              profile
--yes                         Accept project defaults and plan confirmation
--force                       Authorize replacement of listed regular-file
                              conflicts
--install-tools               Authorize allowlisted workstation tool
                              installation
--install-dependencies        Authorize project-local dependency installation

General options
───────────────
Option  Description
──────  ──────────────────────────
--help  Show command-specific help

"
`;

