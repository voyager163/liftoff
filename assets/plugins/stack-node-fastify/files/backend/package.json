{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "{{liftoff.name}} API",
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "start": "node src/server.ts",
    "migrate": "node src/migrate.ts",
    "lint": "biome check .",
    "typecheck": "tsc",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "@scalar/fastify-api-reference": "1.75.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@scalar/json-magic@0.16.0": {
      "undici": "7.30.1"
    }
  }
}
